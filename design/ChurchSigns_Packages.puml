' care to make some suggestions on cleaning up these dependencies?
' dependency graph is messy, at least i think nothing cyclical.
' I am sure I missed some dependencies.
' for restructuring i am considering creating 2 or 3 user controls
' simply to break up the the MainWindow dependencies.
' As you pointed out Util and Helpers can be combined.
' There are Controls that have the extension View, change that to Control
'
@startuml
left to right direction
skinparam packageStyle rectangle

package "ChurchSigns" as cs {
	[App] as app
	[MainWindow] as mainwindow
}

package "ChurchSigns.UI" as ui {
	[Themes.Generic] as themesgeneric
	package "Controls" as controls {
		[FieldPairsView] as fieldpairsview
		[SvgSignControl] as svgsigncontrol
		[TemplateMappingView] as templatemappingview
	}
	package "Interfaces" as interfaces {
		[IClipboardService] as iclipboardservice
	}
	package "Models" as models {
		[ChurchSign] as churchsign
		[GroupInfoList] as groupinfolist
		[PrintContentSize] as printcontentsize
		[SignCategory] as signcategory
		[SignTemplate] as signtemplate
		[SignTemplateDataMap] as signtemplatedatamap
		[TemplateImageSync] as templateimagesync
		[TemplateMediaSize] as templatemediasize
		[TemplateOrientation] as templateorientation
		[TemplateSidecar] as templatesidecar
		[TemplateSignMode] as templatesignmode
		[TemplateStorageItem] as templatestorageitem
	}

	package "Services" as services {
		[SignPdfService] as signpdfservice
		[TemplateStorageService] as templatestorageservice
		[WindowsClipboardService] as windowsclipboardservice
	}

	package "ViewModels" as viewmodels {
		[MainViewModel] as mainviewmodel
	}

	package "Helpers" as helpers {
		[PastedFieldPairs] as pastedfieldpairs
		[PastedRecordData] as pastedrecorddata
		[ProgressDialogHelper] as progressdialoghelper
		[SignJsonContext] as signjsoncontext
	}

	package "Util" as util {
		[MatchConfidence] as matchconfidence
		[SKExtensions] as skextensions
		[StringExtensions] as stringextensions
	}
}

package "ChurchSigns.Tests" as tests

app --> themesgeneric
