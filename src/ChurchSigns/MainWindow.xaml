<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChurchSigns.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChurchSigns"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ChurchSigns.UI.Controls"
    xmlns:models="using:ChurchSigns.UI.Models"
    xmlns:util="using:ChurchSigns.UI.Util"
    mc:Ignorable="d"
    Title="ChurchSigns"
    >


    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
            

    <Grid x:Name="MainGrid" KeyDown="MainGrid_KeyDown" RightTapped="MainGrid_RightTapped">

        <Grid.ColumnDefinitions>
            <!-- Template definitions are in the left Column -->
            <ColumnDefinition Width="Auto"/>
            <!-- Middle column displays the template mapped to data -->
            <ColumnDefinition Width="*"/>
            <!-- The right column displays the mapping of template fields to pasted data -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- first row for a title area -->
            <RowDefinition Height="Auto"/>
            <!-- second row takes up the rest of the screen realestate -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Display application title -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="Church Signs" Margin="36,0,32,32" Style="{ThemeResource TitleTextBlockStyle}" />
        
        <!-- Display available templates -->
        <Grid x:Name="TemplateGrid" Grid.Column="0" Grid.Row="1"
              AllowDrop="True"
              DragOver="TemplateGrid_DragOver"
              Drop="TemplateGrid_Drop"
              BorderThickness="2"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.Resources>
                <CollectionViewSource x:Name="TemplatesCVS" IsSourceGrouped="True"/>
            </Grid.Resources>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Commands -->
                <RowDefinition Height="*"/>    <!-- List of templates -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Templates" Style="{ThemeResource SubtitleTextBlockStyle}"/>

            <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
                <Button x:Name="AddTemplateButton" Margin="8" Content="Add Template" Click="AddTemplateButton_Click"/>
                <Button x:Name="RemoveTemplateButton" Content="Remove" Margin="8" Click="RemoveTemplateButton_Click" IsEnabled="{x:Bind ViewModel.IsCustomSelected,Mode=OneWay}"/>
            </StackPanel>
                
            <ListView x:Name="SignTemplatesListView" Grid.Column="0" Grid.Row="2" 
                      SelectionChanged="SignTemplatesListView_SelectionChanged"
                      ItemsSource="{x:Bind TemplatesCVS.View, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="models:GroupInfoList">
                                <Border AutomationProperties.AccessibilityView="Raw">
                                    <TextBlock Text="{x:Bind Key}" AutomationProperties.AccessibilityView="Raw" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SignTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:SvgSignControl
                                Grid.Column="0"
                                SvgTemplate="{x:Bind SvgSignTemplate, Mode=OneWay}"
                                Data="{x:Bind PreviewFields, Mode=OneWay}"
                                Height="65"
                                Width="85"
                                RenderHeight="65"
                                RenderWidth="85"
                                />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <Button x:Name="EditTemplateButton" Content="Edit" Margin="8" Click="EditTemplateButton_Click" IsEnabled="{x:Bind IsCustom, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                       
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
        </Grid>
        
        

        <!-- Preview of Signs Here -->
        <GridView x:Name="SignGridView" Grid.Column="1" Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.Signs}"
                  BorderBrush="{ThemeResource ControlElevationBorderBrush}" 
                  BorderThickness="2" VerticalAlignment="Top">
            
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
           
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:SignData">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:SvgSignControl
                            SvgTemplate="{x:Bind Template, Mode=OneTime}"
                            Data="{x:Bind Fields, Mode=OneTime}"
                            Height="130"
                            Width="190"
                            RenderHeight="130"
                            RenderWidth="190"/>
                        
                        <TextBlock Grid.Row="1" Text="{x:Bind Title}"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Field Mapping area -->

        <Grid Grid.Column="2" Grid.Row="1"              BorderThickness="2" 
              AllowFocusWhenDisabled="True"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="PasteButton" Content="Paste" Margin="8"
                        Click="PasteButton_Click"
                        IsEnabled="{x:Bind HasPasteData, Mode=OneWay}"/>
                <TextBlock Margin="8" Style="{ThemeResource BodyTextBlockStyle}">Spreadsheet with header name(s)</TextBlock>
            </StackPanel>

            <Grid x:Name="TemplateMappingGrid" 
                  Grid.Column="0" Grid.Row="1"
                   >
                <Grid.RowDefinitions>
                    <!-- The fields of the template mapped to the column headers of pasted data -->
                    <RowDefinition Height="Auto"/>
                    <!-- The pasted data -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- fairly complex so this is in code -->
                <Grid x:Name="FieldMapGrid" Grid.Row="0">
                </Grid>


                <Grid x:Name="FieldDataGrid" Grid.Row="1" />
            
            </Grid>
        </Grid>

    </Grid>        

</Window>
