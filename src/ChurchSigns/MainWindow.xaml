<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChurchSigns.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChurchSigns"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ChurchSigns.UI.Controls"
    xmlns:models="using:ChurchSigns.UI.Models"
    xmlns:util="using:ChurchSigns.UI.Util"
    mc:Ignorable="d"
    Title="ChurchSigns"
    >


    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
            

    <Grid x:Name="MainGrid" KeyDown="MainGrid_KeyDown">

        <Grid.ColumnDefinitions>
            <!-- Template definitions are in the left Column -->
            <ColumnDefinition Width="Auto"/>
            <!-- The center column displays the mapping of template fields to pasted data -->
            <ColumnDefinition Width="*"/>
            <!-- The right column displays the template mapped to data -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- first row for a title area -->
            <RowDefinition Height="Auto"/>
            <!-- second row takes up the rest of the screen realestate -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Grid.ColumnSpan="3"/>
        <Canvas x:Name="PrintCanvas" Opacity="0" IsHitTestVisible="False"
        Width="0" Height="0" />
        <!-- Display application title -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="Church Signs" Margin="36,0,32,32" Style="{ThemeResource TitleTextBlockStyle}" />
        
        <!-- Display available templates -->
        <Grid x:Name="TemplateGrid" Grid.Column="0" Grid.Row="1"
              AllowDrop="True"
              DragOver="TemplateGrid_DragOver"
              Drop="TemplateGrid_Drop"
              BorderThickness="2"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.Resources>
                <CollectionViewSource x:Name="TemplatesCVS" IsSourceGrouped="True"/>
            </Grid.Resources>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- List of templates -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" BorderThickness="2" BorderBrush="Azure" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"  Source="/Assets/TemplatesArea.png" Width="87" Height="100" Margin="8" />
                <StackPanel Orientation="Vertical" Grid.Column="1" >
                    <Button x:Name="DesignerInfoButton" Content="ℹ️" VerticalAlignment="Top" Margin="46,8,0,0" Click="DesignerInfoButton_Click"/>
                    <CheckBox x:Name="IsDesigner" IsChecked="False" VerticalAlignment="Top" Margin="16,4,0,0" Checked="IsDesigner_Checked" Unchecked="IsDesigner_Unchecked" Content="Designer:"/>
                </StackPanel>
                <StackPanel x:Name="DesignerStackPanel" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button x:Name="RemoveTemplateButton" Content="Remove" Margin="1" Click="RemoveTemplateButton_Click"  IsEnabled="False"/>
                    <Button x:Name="AddTemplateButton" Margin="1" Content="Import" Click="AddTemplateButton_Click" IsEnabled="False" />
                    <Button x:Name="ExportTemplateButton" Content="Export" Margin="1" Click="ExportTemplateButton_Click"  IsEnabled="False"/>
                </StackPanel>
            </Grid>

                
            <ListView x:Name="SignTemplatesListView" Grid.Column="0" Grid.Row="1" 
                      SelectionChanged="SignTemplatesListView_SelectionChanged"
                      ItemsSource="{x:Bind TemplatesCVS.View, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="models:GroupInfoList">
                                <Border AutomationProperties.AccessibilityView="Raw">
                                    <TextBlock Text="{x:Bind Key}" AutomationProperties.AccessibilityView="Raw" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SignTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:SvgSignControl
                                Grid.Column="0"
                                Margin="4"
                                SvgTemplate="{x:Bind SvgSignTemplate, Mode=OneTime}"
                                Data="{x:Bind PreviewFields, Mode=OneTime}"
                                Height="{x:Bind XAMLThumbnailSize.Height}"
                                Width="{x:Bind XAMLThumbnailSize.Width}"
                                RenderHeight="{x:Bind XAMLThumbnailSize.Height}"
                                RenderWidth="{x:Bind XAMLThumbnailSize.Width}"
                                />
                                <TextBlock Grid.Column="1"  Text="{x:Bind Title}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                        </Grid>
                       
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
        </Grid>
        
        

        <!-- Field Mapping area -->

        <Grid Grid.Column="1" Grid.Row="1" 
              AllowFocusWhenDisabled="True"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
              >
            
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" BorderThickness="2" BorderBrush="Azure">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Margin="8,0,0,0" Source="/Assets/PasteArea.png" Width="87" Height="100"/>
                
                <Button Grid.Column="1" x:Name="PasteButton" Content="Paste from spreadsheet" Margin="8"
                        Click="PasteButton_Click"
                        />
                <RichTextBlock Grid.Column="2" x:Name="PasteHelpTextBlock" Margin="8" TextWrapping="WrapWholeWords">
                    <Paragraph>Copy cells from
                        <Bold>Google Sheets</Bold> or
                        <Bold>Excel</Bold>, then click Paste.</Paragraph>
                    <Paragraph>Use a
                        <Bold>header row</Bold> (e.g. Name, Room) and
                        <Bold>one row per sign</Bold>.</Paragraph>
                    <Paragraph>Do
                        <Bold>not</Bold> paste from a PDF or Word table—those usually have no column tabs, so ChurchSigns cannot tell columns apart.
                    </Paragraph>
                </RichTextBlock>
            </Grid>
                

           
            <controls:TemplateMappingView 
                x:Name="MappingView"
                Grid.Column="0"
                Grid.Row="1"
                SelectedTemplate="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay}"
                PastedData="{x:Bind ViewModel.LastTablePaste, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.MultiSignVisibility, Mode=OneWay}"
                />
            <controls:FieldPairsView
                x:Name="PairsView"
                Grid.Column="0"
                Grid.Row="1"
                SelectedTemplate="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay}"
                PastedData="{x:Bind ViewModel.LastFieldPairs, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.SingleSignVisibility, Mode=OneWay}"
                />

        </Grid>


        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" BorderThickness="2" BorderBrush="Azure">
                <Image Source="/Assets/PrintArea.png" Margin="8" Width="87" Height="100"/>
                <StackPanel Orientation="Vertical">
                    <Button Margin="4" x:Name="PrintButton" Content="Print" Click="PrintButton_Click" IsEnabled="False"/>
                    <Button Margin="4" x:Name="PdfExportButton" Content="Export to PDF" Click="PdfExportButton_Click" IsEnabled="False"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All Signs" Margin="4" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AllSignsCheckBox"
            VerticalAlignment="Center"
        Checked="AllSignsCheckBox_Checked"
        Unchecked="AllSignsCheckBox_Unchecked"/>
                    </StackPanel>
                </StackPanel>
                
                

            </StackPanel>


            <GridView x:Name="SignGridView"
                  Grid.Row="1"
                  SelectionMode="Multiple"
                  SelectionChanged="SignGridView_SelectionChanged"
                  ItemsSource="{x:Bind ViewModel.Signs}"
                  BorderBrush="{ThemeResource ControlElevationBorderBrush}" 
                  Background="LightGray"
                  BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>

                    <DataTemplate x:DataType="models:ChurchSign">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:SvgSignControl
                            SvgTemplate="{x:Bind SvgTemplate, Mode=OneTime}"
                            Data="{x:Bind Fields, Mode=OneTime}"
                            Height="{x:Bind XAMLPreviewSize.Height}"
                            Width="{x:Bind XAMLPreviewSize.Width}"
                            RenderHeight="{x:Bind XAMLPreviewSize.Height}"
                            RenderWidth="{x:Bind XAMLPreviewSize.Width}"/>

                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>


    </Grid>        

</Window>
