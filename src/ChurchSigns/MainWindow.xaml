<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChurchSigns.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChurchSigns"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ChurchSigns.UI.Controls"
    xmlns:models="using:ChurchSigns.UI.Models"
    xmlns:util="using:ChurchSigns.UI.Util"
    mc:Ignorable="d"
    Title="ChurchSigns">


    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
            

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Display application title -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="Church Signs" Margin="36,0,32,32" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- Display available templates -->
        <Grid x:Name="TemplateGrid" Grid.Column="0" Grid.Row="1" BorderThickness="2" BorderBrush="{ThemeResource ControlElevationBorderBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.Resources>
                <CollectionViewSource x:Name="TemplatesCVS" IsSourceGrouped="True"/>
            </Grid.Resources>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Margin="8">Description stuff and File Open Dialog</TextBlock>
            <ListView x:Name="SignTemplatesListView" Grid.Column="0" Grid.Row="1" SelectionChanged="SignTemplatesListView_SelectionChanged" ItemsSource="{x:Bind TemplatesCVS.View, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="util:GroupInfoList">
                                <Border AutomationProperties.AccessibilityView="Raw">
                                    <TextBlock Text="{x:Bind Key}" AutomationProperties.AccessibilityView="Raw" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SignTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:SvgSignControl
                                Grid.Column="0"
                                SvgTemplate="{x:Bind SvgSignTemplate, Mode=OneTime}"
                                Height="65"
                                Width="85"
                                RenderHeight="65"
                                RenderWidth="85"
                                />
                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{ThemeResource BodyLargeTextBlockStyle}"/>
                        </Grid>
                       
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
        </Grid>
        

        <!-- Preview of Signs Here -->
        <GridView x:Name="SignGridView" Grid.Column="1" Grid.Row="1" 
                  ItemsSource="{x:Bind Signs}"
                  BorderBrush="{ThemeResource ControlElevationBorderBrush}" 
                  BorderThickness="2" VerticalAlignment="Top">
            
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
           
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:SignData">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:SvgSignControl
                            SvgTemplate="{x:Bind Template, Mode=OneTime}"
                            Data="{x:Bind Fields, Mode=OneTime}"
                            Height="130"
                            Width="190"
                            RenderHeight="130"
                            RenderWidth="190"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind Title}"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Display Field Data-->
        <Border Grid.Column="2" Grid.Row="1" BorderThickness="2" BorderBrush="{ThemeResource ControlElevationBorderBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock >Show Field Data Here</TextBlock>
        </Border>


    </Grid>        

</Window>
