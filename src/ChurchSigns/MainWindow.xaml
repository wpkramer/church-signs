<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChurchSigns.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChurchSigns"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uctl="using:ChurchSigns.UserControls"
    xmlns:controls="using:ChurchSigns.UI.Controls"
    xmlns:models="using:ChurchSigns.UI.Models"
    xmlns:util="using:ChurchSigns.UI.Helpers"
    mc:Ignorable="d"
    Title="ChurchSigns"
    >


    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
            

    <Grid x:Name="MainGrid" KeyDown="MainGrid_KeyDown" Loaded="MainGrid_Loaded">

        <Grid.ColumnDefinitions>
            <!-- Template definitions are in the left Column -->
            <ColumnDefinition Width="Auto"/>
            <!-- The center column displays the mapping of template fields to pasted data -->
            <ColumnDefinition Width="*"/>
            <!-- The right column displays the template mapped to data -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- first row for a title area -->
            <RowDefinition Height="Auto"/>
            <!-- second row takes up the rest of the screen realestate -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Grid.ColumnSpan="3"/>

        <!-- Display application title -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="Church Signs" Margin="36,0,32,32" Style="{ThemeResource TitleTextBlockStyle}" />
        
        <!-- Display available templates -->
        <uctl:TemplateUserControl x:Name="TemplateSelector" Grid.Column="0" Grid.Row="1"
                          SelectedTemplate="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay}"
                          />


        <!-- Field Mapping area -->

        <Grid Grid.Column="1" Grid.Row="1" 
              AllowFocusWhenDisabled="True"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
              >
            
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" BorderThickness="2" BorderBrush="Azure">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Margin="8,0,0,0" Source="/Assets/PasteArea.png" Width="87" Height="100"/>
                
                <Button Grid.Column="1" x:Name="PasteButton" Content="Paste from spreadsheet" Margin="8"
                        Click="PasteButton_Click"
                        />
                <RichTextBlock Grid.Column="2" x:Name="PasteHelpTextBlock" Margin="8" TextWrapping="WrapWholeWords">
                    <Paragraph>Copy cells from
                        <Bold>Google Sheets</Bold> or
                        <Bold>Excel</Bold>, then click Paste.</Paragraph>
                    <Paragraph>Use a
                        <Bold>header row</Bold> (e.g. Name, Room) and
                        <Bold>one row per sign</Bold>.</Paragraph>
                    <Paragraph>Do
                        <Bold>not</Bold> paste from a PDF or Word table—those usually have no column tabs, so ChurchSigns cannot tell columns apart.
                    </Paragraph>
                </RichTextBlock>
            </Grid>
                

           <!-- Displays the available field mapping for a sign template -->
            <controls:TemplateMappingControl 
                x:Name="MappingView"
                Grid.Column="0"
                Grid.Row="1"
                SelectedTemplate="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay}"
                PastedData="{x:Bind ViewModel.LastTablePaste, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.MultiSignVisibility, Mode=OneWay}"
                />
            
            <!-- Displays the signs?? -->
            <controls:FieldPairsControl
                x:Name="PairsView"
                Grid.Column="0"
                Grid.Row="1"
                SelectedTemplate="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay}"
                PastedData="{x:Bind ViewModel.LastFieldPairs, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.SingleSignVisibility, Mode=OneWay}"
                />

        </Grid>

        <uctl:SignPrintUserControl x:Name="SignPrintSelector" Grid.Column="2" Grid.Row="1"/>




    </Grid>        

</Window>
