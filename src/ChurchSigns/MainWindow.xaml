<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChurchSigns.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChurchSigns"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ChurchSigns.UI.Controls"
    xmlns:models="using:ChurchSigns.UI.Models"
    xmlns:util="using:ChurchSigns.UI.Util"
    mc:Ignorable="d"
    Title="ChurchSigns"
    >


    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
            

    <Grid x:Name="MainGrid" KeyDown="MainGrid_KeyDown" RightTapped="MainGrid_RightTapped">

        <Grid.ColumnDefinitions>
            <!-- Template definitions are in the left Column -->
            <ColumnDefinition Width="350"/>
            <!-- Middle column displays the template mapped to data -->
            <ColumnDefinition Width="400"/>
            <!-- The right column displays the mapping of template fields to pasted data -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- first row for a title area -->
            <RowDefinition Height="Auto"/>
            <!-- second row takes up the rest of the screen realestate -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Canvas x:Name="PrintCanvas" Opacity="0" IsHitTestVisible="False"
        Width="0" Height="0" />
        <!-- Display application title -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="Church Signs" Margin="36,0,32,32" Style="{ThemeResource TitleTextBlockStyle}" />
        
        <!-- Display available templates -->
        <Grid x:Name="TemplateGrid" Grid.Column="0" Grid.Row="1"
              AllowDrop="True"
              DragOver="TemplateGrid_DragOver"
              Drop="TemplateGrid_Drop"
              BorderThickness="2"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.Resources>
                <CollectionViewSource x:Name="TemplatesCVS" IsSourceGrouped="True"/>
            </Grid.Resources>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- List of templates -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" BorderThickness="2" BorderBrush="Azure" >
                <StackPanel  Orientation="Vertical" >
                    <TextBlock Margin="4" Text="Sign Templates" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddTemplateButton" Margin="8" Content="Add Template" Click="AddTemplateButton_Click"/>
                        <Button x:Name="RemoveTemplateButton" Content="Remove" Margin="8" Click="RemoveTemplateButton_Click" IsEnabled="{x:Bind ViewModel.IsCustomSelected,Mode=OneWay}"/>
                        <Button x:Name="ExportTemplateButton" Content="Export" Margin="8" Click="ExportTemplateButton_Click"/>
                    </StackPanel>                
                </StackPanel>
            </Border>

                
            <ListView x:Name="SignTemplatesListView" Grid.Column="0" Grid.Row="1" 
                      SelectionChanged="SignTemplatesListView_SelectionChanged"
                      ItemsSource="{x:Bind TemplatesCVS.View, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="models:GroupInfoList">
                                <Border AutomationProperties.AccessibilityView="Raw">
                                    <TextBlock Text="{x:Bind Key}" AutomationProperties.AccessibilityView="Raw" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SignTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:SvgSignControl
                                Grid.Column="0"
                                Margin="4"
                                SvgTemplate="{x:Bind SvgSignTemplate, Mode=OneWay}"
                                Data="{x:Bind PreviewFields, Mode=OneWay}"
                                Height="{x:Bind ThumbnailSize.Height}"
                                Width="{x:Bind ThumbnailSize.Width}"
                                RenderHeight="{x:Bind ThumbnailSize.Height}"
                                RenderWidth="{x:Bind ThumbnailSize.Height}"
                                />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <!--<Button x:Name="EditTemplateButton" Content="Edit" Margin="8" Click="EditTemplateButton_Click" IsEnabled="{x:Bind IsCustom, Mode=OneWay}"/>-->
                            </StackPanel>
                        </Grid>
                       
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
        </Grid>
        
        

        <!-- Preview of Signs to print Here -->
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Visibility="{x:Bind ViewModel.NewSignTemplateVisiblity, Mode=OneWay}" BorderThickness="2" BorderBrush="Azure" Height="120" Width="400">
                <TextBlock Margin="8" Text="Paste data to see signs for printing." Width="276"  Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <Image  Source="/Assets/PasteArea.png" Width="100" Height="100" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="0"  Visibility="{x:Bind ViewModel.SignsWithDataVisiblility, Mode=OneWay}" BorderThickness="2" BorderBrush="Azure" Height="120" Width="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" Text="Signs" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="All Signs" Margin="4" VerticalAlignment="Center"/>
                    <CheckBox x:Name="AllSignsCheckBox"
                              VerticalAlignment="Center"
                            Checked="AllSignsCheckBox_Checked"
                            Unchecked="AllSignsCheckBox_Unchecked"/>

                </StackPanel>
                          
           
                <Button Margin="4" Grid.Row="1" Grid.Column="0" x:Name="PrintButton" Content="Print" Click="PrintButton_Click"/>
                <Button Margin="4" Grid.Row="2" Grid.Column="0" x:Name="PdfExportButton" Content="Export to PDF" Click="PdfExportButton_Click"/>
            </Grid>

                



            <GridView x:Name="SignGridView"
                  Grid.Row="1"
                  SelectionMode="Multiple"
                  SelectionChanged="SignGridView_SelectionChanged"
                  ItemsSource="{x:Bind ViewModel.Signs}"
                  BorderBrush="{ThemeResource ControlElevationBorderBrush}" 
                  Background="LightGray"
                  BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center">
            
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
           
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ChurchSign">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!--<RowDefinition Height="Auto"/>-->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:SvgSignControl
                            SvgTemplate="{x:Bind SvgTemplate, Mode=OneWay}"
                            Data="{x:Bind Fields, Mode=OneWay}"
                            Height="{x:Bind PreviewSize.Height}"
                            Width="{x:Bind PreviewSize.Width}"
                            RenderHeight="{x:Bind PreviewSize.Height}"
                            RenderWidth="{x:Bind PreviewSize.Height}"/>
                        
                        <!-- remove the render attributes and make it the same in the control -->
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        </Grid>
        <!-- Field Mapping area -->

        <Grid Grid.Column="2" Grid.Row="1"              BorderThickness="2" 
              AllowFocusWhenDisabled="True"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="PasteButton" Content="Paste" Margin="8"
                        Click="PasteButton_Click"
                        IsEnabled="{x:Bind HasPasteData, Mode=OneWay}"/>
                <TextBlock Margin="8" Style="{ThemeResource SubtitleTextBlockStyle}">Spreadsheet with header name(s)</TextBlock>
            </StackPanel>

            <Grid x:Name="TemplateMappingGrid" 
                  Grid.Column="0" Grid.Row="1"
                   >
                <Grid.RowDefinitions>
                    <!-- The fields of the template mapped to the column headers of pasted data -->
                    <RowDefinition Height="Auto"/>
                    <!-- The pasted data -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- fairly complex so this is in code -->
                <Grid x:Name="FieldMapGrid" Grid.Row="0">
                </Grid>


                <Grid x:Name="FieldDataGrid" Grid.Row="1" />
            
            </Grid>
        </Grid>

    </Grid>        

</Window>
