<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChurchSigns.UserControls.TemplateUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChurchSigns.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ChurchSigns.UI.Models"
    xmlns:controls="using:ChurchSigns.UI.Controls"
    mc:Ignorable="d">
    <Grid x:Name="TemplateGrid" Grid.Column="0" Grid.Row="1"
              AllowDrop="True"
              DragOver="TemplateGrid_DragOver"
              Drop="TemplateGrid_Drop"
              BorderThickness="2"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
        <Grid.Resources>
            <CollectionViewSource x:Name="TemplatesCVS" IsSourceGrouped="True"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- List of templates -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" BorderThickness="2" BorderBrush="Azure" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"  Source="/Assets/TemplatesArea.png" Width="87" Height="100" Margin="8" />
            <StackPanel Orientation="Vertical" Grid.Column="1" >
                <Button x:Name="DesignerInfoButton" Content="ℹ️" VerticalAlignment="Top" Margin="46,8,0,0" Click="DesignerInfoButton_Click"/>
                <CheckBox x:Name="IsDesigner" IsChecked="False" VerticalAlignment="Top" Margin="16,4,0,0" Content="Designer:" Checked="IsDesigner_Changed" Unchecked="IsDesigner_Changed"/>
            </StackPanel>
            <StackPanel x:Name="DesignerStackPanel" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.IsDesignerMode, Mode=OneWay}">
                <Button x:Name="RemoveTemplateButton" Content="Remove" Margin="1" Click="RemoveTemplateButton_Click" IsEnabled="{x:Bind ViewModel.IsCustomSelected, Mode=OneWay}" />
                <Button x:Name="AddTemplateButton" Margin="1" Content="Import" Click="AddTemplateButton_Click"  />
                <Button x:Name="ExportTemplateButton" Content="Export" Margin="1" Click="ExportTemplateButton_Click" />
            </StackPanel>
        </Grid>


        <ListView x:Name="SignTemplatesListView" Grid.Column="0" Grid.Row="1" 
                      SelectionMode="Single"
                      SelectionChanged="SignTemplatesListView_SelectionChanged"
                      ItemsSource="{x:Bind TemplatesCVS.View, Mode=OneWay}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="models:GroupInfoList">
                            <Border AutomationProperties.AccessibilityView="Raw">
                                <TextBlock Text="{x:Bind Key}" AutomationProperties.AccessibilityView="Raw" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SignTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:SvgSignControl
                                Grid.Column="0"
                                Margin="4"
                                SvgTemplate="{x:Bind SvgSignTemplate, Mode=OneTime}"
                                Data="{x:Bind PreviewFields, Mode=OneTime}"
                                Height="{x:Bind XAMLThumbnailSize.Height}"
                                Width="{x:Bind XAMLThumbnailSize.Width}"
                                RenderHeight="{x:Bind XAMLThumbnailSize.Height}"
                                RenderWidth="{x:Bind XAMLThumbnailSize.Width}"
                                />
                        <TextBlock Grid.Column="1"  Text="{x:Bind Title}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>

</UserControl>
