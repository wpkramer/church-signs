<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ChurchSigns.Dialogs.SignTemplateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ChurchSigns.UI.ViewModels"
    xmlns:model="using:ChurchSigns.UI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sign Template"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    Width="300"
    Height="200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TemplateNameTextBlock"
            Grid.Row="0"
            Text=""
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Margin="8" />
        <ScrollViewer Grid.Row="1" Margin="8">
            <ItemsControl x:Name="TemplateItemsControl"
                ItemsSource="{x:Bind ViewModel.PreviewFields, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:SignTemplateProperty">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{x:Bind Name}" Width="100" VerticalAlignment="Center" />
                            <TextBox Text="{x:Bind Value, Mode=TwoWay}" Width="200" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
